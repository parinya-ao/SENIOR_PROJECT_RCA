+++ b/tools/updi-references.py
@@ -0,0 +1,34 @@
+"""Acquire and hash primary references; never opens a target connection."""
+import datetime
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+import urllib.request
+
+ROOT = Path(__file__).resolve().parents[1]
+OUT = ROOT / 'evidence/updi/deep-debug/references'
+OUT.mkdir(exist_ok=True)
+sources = {
+    'errata.pdf': 'https://ww1.microchip.com/downloads/aemDocuments/documents/MCU08/ProductDocuments/Errata/AVR128DA-28-32-48-64-SilConErrataClarif-DS80000882.pdf',
+    'datasheet.pdf': 'https://ww1.microchip.com/downloads/aemDocuments/documents/MCU08/ProductDocuments/DataSheets/AVR128DA28-32-48-64-Data-Sheet-DS40002183.pdf',
+    'cp2102.pdf': 'https://www.silabs.com/documents/public/data-sheets/CP2102-9.pdf',
+    'cp210x.c': 'https://raw.githubusercontent.com/torvalds/linux/v6.17/drivers/usb/serial/cp210x.c',
+}
+manifest = {}
+for name, url in sources.items():
+    path = OUT / name
+    try:
+        request = urllib.request.Request(url, headers={'User-Agent': 'Mozilla/5.0'})
+        with urllib.request.urlopen(request, timeout=45) as response:
+            data = response.read()
+        path.write_bytes(data)
+        manifest[name] = dict(url=url, utc=datetime.datetime.now(datetime.timezone.utc).isoformat(),
+                              bytes=len(data), sha256=hashlib.sha256(data).hexdigest())
+        if name.endswith('.pdf'):
+            subprocess.run(['pdftotext', '-layout', str(path), str(path.with_suffix('.txt'))], check=True)
+        print(name, len(data))
+    except Exception as exc:
+        manifest[name] = dict(url=url, error=str(exc))
+        print(name, type(exc).__name__, str(exc))
+(OUT / 'manifest.json').write_text(json.dumps(manifest, indent=2) + '\n')
diff --git a/tools/updi-campaign.py b/tools/updi-campaign.py
new file mode 100644
index 0000000..f79732d
--- /dev/null
+++ b/tools/updi-campaign.py
@@ -0,0 +1,60 @@
+"""Sequential independent trials; every trial uses the bounded existing-library harness."""
+import argparse
+from collections import Counter
+import json
+from pathlib import Path
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('output')
+    parser.add_argument('--backend', choices=['upstream', 'oracle24', 'oracle16'], default='upstream')
+    parser.add_argument('--trials', type=int, default=20)
+    parser.add_argument('--double-break', action='store_true')
+    args = parser.parse_args()
+    assert 1 <= args.trials <= 20
+    output = Path(args.output)
+    output.mkdir(exist_ok=False)
+    addresses = (0x1c, 0x1d, 0x1e, 0x1f, 0x40, 0x63)
+    if args.backend != 'upstream':
+        addresses += (0x4000, 0xf01, 0x1051)
+    operations = [('sib', None), ('control', None)] + [('read', a) for a in addresses] + [('scratch', None)]
+    summary = []
+    for baud in (38400, 57600, 115200):
+        for mode, address in operations:
+            counts = Counter()
+            for trial in range(args.trials):
+                name = f'{baud}-{mode}-{address if address is not None else 0:04x}-{trial:02d}.json'
+                path = output / name
+                cmd = [sys.executable, str(ROOT / 'tools/updi-diagnose.py'), mode, str(path),
+                    '--backend', args.backend, '--baud', str(baud),
+                    '--hypothesis', 'Equivalent operation depends on observed target state and transport baud',
+                    '--falsifier', 'Failure invariant across states or isolated to one address/backend',
+                    '--variable', f'{mode} independent attachment; baud block {baud}; address {address}']
+                if address is not None:
+                    cmd += ['--address', str(address)]
+                if args.double_break:
+                    cmd += ['--double-break']
+                proc = subprocess.run(cmd, cwd=ROOT, capture_output=True, timeout=30)
+                assert path.exists(), proc.stderr.decode(errors='replace')
+                data = json.loads(path.read_text())
+                assert proc.returncode == data['exit'], (proc.returncode, data['exit'])
+                counts['trials'] += 1
+                counts['success' if data['exit'] == 0 else 'failure'] += 1
+                if data['exit'] and mode == 'scratch':
+                    # A lost ACK may leave GPR1 changed. Require explicit restoration before proceeding.
+                    print(f'STOP: scratch failure, inspect/restore GPR1 using {path}', flush=True)
+                    return 1
+            row = dict(backend=args.backend, baud=baud, mode=mode, address=address, **counts)
+            summary.append(row)
+            print(json.dumps(row), flush=True)
+            (output / 'summary.json').write_text(json.dumps(summary, indent=2) + '\n')
+    return 0
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
diff --git a/tools/updi-finish-evidence.py b/tools/updi-finish-evidence.py
new file mode 100644
index 0000000..b2329d9
--- /dev/null
+++ b/tools/updi-finish-evidence.py
@@ -0,0 +1,130 @@
+"""Summarize raw experiment records and preserve final host/source verification."""
+from collections import Counter, defaultdict
+import datetime
+import hashlib
+import json
+from pathlib import Path
+import subprocess
+
+ROOT = Path(__file__).resolve().parents[1]
+OUT = ROOT / 'evidence/updi/deep-debug'
+groups = defaultdict(Counter)
+states = defaultdict(Counter)
+for path in sorted(OUT.glob('**/*.json')):
+    data = json.loads(path.read_text())
+    if not isinstance(data, dict) or 'events' not in data:
+        continue
+    group = str(path.parent.relative_to(OUT))
+    counts = groups[group]
+    counts['sessions'] += 1
+    counts['success' if data['exit'] == 0 else 'failure'] += 1
+    state = data.get('target_state')
+    if isinstance(state, dict):
+        states[group][json.dumps(state, sort_keys=True)] += 1
+    last_tx = b''
+    pending_sts = 0
+    for event in data['events']:
+        raw = bytes.fromhex(event['hex'])
+        if event['kind'] == 'tx':
+            last_tx = raw
+            if len(raw) >= 3 and raw[0] == 0x55 and raw[1] & 0xe0 == 0x40:
+                pending_sts = 1
+        elif event['kind'] == 'echo':
+            counts['echo_reads'] += 1
+            if raw != last_tx:
+                counts['echo_errors'] += 1
+        elif event['kind'] == 'response':
+            counts['response_reads'] += 1
+            if pending_sts:
+                if raw != b'\x40':
+                    counts[f'ack{pending_sts}_errors'] += 1
+                else:
+                    counts[f'ack{pending_sts}_ok'] += 1
+                pending_sts = 2 if pending_sts == 1 and raw == b'\x40' else 0
+            elif data['mode'] == 'sib' and data['backend'] != 'upstream' and last_tx == b'\x55\xe6' and raw == b'':
