+        0x1d:0x72,0x1e:0x74,0x26:4,0x39:0x12,0x33:0x27,0x3b:0x1d,
+        0x40:0,0x11:0,0x20:0,0x21:8,0x41:0}
+    mismatches={f'{address:02X}':dict(expected=value,observed=registers[address])
+        for address,value in expected.items() if registers[address]!=value}
+    if registers[0x42] not in (0x11,0x12,0x13):mismatches['42']='unsupported RegVersion'
+    # RadioLib BW125 erratum clears AutomaticIFOn on RX entry; reserved bits are ignored.
+    if rx and registers[0x31]&0x87!=3:mismatches['31']='RX erratum/SF detection mismatch'
+    if mismatches:raise ValueError('ARQ radio configuration mismatch: '+json.dumps(mismatches))
+    return dict(frequency_hz=int.from_bytes(values[1:4],'big')*32000000//(1<<19),
+        registers={f'{address:02X}':value for address,value in registers.items()})
+
