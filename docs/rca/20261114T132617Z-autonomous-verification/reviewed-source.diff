+def radio_only_bringup(args,*,exchange=False):
+    """Program Tracker first, inspect both radios, and park the installed diagnostics."""
+    from types import SimpleNamespace
+    from generate_lora_config import generate,digest
+    from device_detection.firmware_identity import normalize_ihex_region
+    from arq_config import load_arq
+    errors=hardware_gate_errors(args,exchange)
+    if errors:raise ValueError('radio-only preflight incomplete: '+'; '.join(errors))
+    generate(check=True)
+    manifest=json.loads((ROOT/'generated/arq_manifest.json').read_text())
+    budget=hello_airtime_budget(load_arq())
+    run_dir=ROOT/'artifacts/arq'/datetime.now(timezone.utc).strftime('%Y%m%dT%H%M%S%fZ-radio-only-bringup')
+    proof=rf.ProofRun(run_dir);capture=Capture(proof)
+    report=dict(status='UNKNOWN',exchange_requested=exchange,airtime=budget,programming={},
+        rf_release='operator-confirmed' if exchange else 'PENDING',radio={},cleanup={})
+    session=0
+    def read_radio(role,rx):
+        start=len(capture.events);capture.command(role,'STATUS')
+        capture.wait(lambda:status_complete(capture.events[start:],role,session),45)
+        rows=[e for e in capture.events[start:] if e.get('role')==role]
+        statuses=[e for e in rows if e.get('e')=='STATUS']
+        registers=[e for e in rows if e.get('e')=='REG']
+        if (not statuses or not registers or statuses[-1].get('ready')!='1' or
+                statuses[-1].get('overflow')!='0' or
+                any(int(e['s'],16)!=session for e in rows)):
+            raise ValueError('fresh radio status/readiness not verified: '+role)
+        return audit_radio_configuration(registers[-1],rx=rx)
+    try:
+        config=subprocess.check_output(['pio','project','config','--json-output'],cwd=ROOT,text=True)
+        if not rf.upload_ports_match(config) or not rf.upload_config_preserves_flash(config):
+            raise ValueError('upload mapping/preservation configuration mismatch')
+        candidates={}
+        for role in ('receiver','sender'):
+            environment=role+'_arq_radio_only'
+            metadata=reader_free_h01_firmware(ROOT,role)
+            if metadata['build_id']!=digest(dict(environment=environment,arq=manifest)):
+                raise ValueError('stale candidate build identity: '+role)
+            image=ROOT/'.pio/build'/environment/'firmware.hex'
+            data=image.read_bytes();region=rf.parse_ihex_range(data)
+            expected=normalize_ihex_region(data.decode('ascii'),region['start'],region['end_exclusive'])
+            if metadata['build_id'].encode() not in expected:raise ValueError('candidate image/build identity mismatch: '+role)
+            (run_dir/(environment+'.hex')).write_bytes(data)
+            if sha(run_dir/(environment+'.hex'))!=metadata['sha256']:raise ValueError('candidate image hash changed: '+role)
+            candidates[role]=metadata
+        for role in ('receiver','sender'):
+            environment=role+'_arq_radio_only'
+            if rf.check_port_owners(proof,environment+'-preflight'):raise ValueError('UPDI ports owned')
+            identity_args=SimpleNamespace(physical_mapping_verified=True,power_verified=True)
+            if rf.identify_targets(proof,identity_args,config):raise ValueError('current identity/fuse preflight failed')
+            metadata=candidates[role]
+            if rf.program_application(proof,environment,config):raise ValueError('programming/readback failed: '+role)
+            report['programming'][role]=metadata
+        capture.start();capture.acquire(report['programming'],manifest['config_hash'])
+        for role in ('receiver','sender'):
+            report['radio'][role]=audit_radio_configuration(capture.seen(role,'REG')[-1],rx=False)
+        session=reserve_session(ROOT/'artifacts/arq')
+        report['session']=session
+        for role in ('receiver','sender'):
+            capture.command(role,f'ARM {session:08X}')
+            capture.wait(lambda:bool([e for e in capture.seen(role,'ARM')
+                if int(e['s'],16)==session and e.get('rc')=='0']),15)
+            report['radio'][role]=read_radio(role,True)
+        if exchange:
+            capture.command('sender','SEND '+HELLO_PAYLOAD.hex().upper())
+            capture.wait(lambda:bool([e for e in capture.events if e.get('role')=='sender' and
+                e.get('e') in ('DELIVERED','REJECTED','PROTOCOL_ERROR','TIMEOUT_EXHAUSTED','RADIO_ERROR')]),30)
+            for role in ('receiver','sender'):
+                report['radio'][role]=read_radio(role,True)
+            report['exchange']=validate_hello_exchange(capture.events,session)
+            if report['exchange']['complete'] is not True:raise ValueError('HELLO_LORA checkpoints incomplete')
+        elif any(e.get('e') in ('TX','TX_DONE','REQUEST') for e in capture.events):
+            raise ValueError('unexpected RF activity in non-transmitting bring-up')
+        report['status']='PASS'
+    except Exception as error:
+        report.update(status='UNKNOWN',failure=f'{type(error).__name__}: {error}')
+        raise
+    finally:
+        # Park through the existing X command; never reflash normal images during cleanup.
+        for role in capture.monitors:
+            try:
+                capture.command(role,'X');read_radio(role,False)
+                report['cleanup'][role]='PARKED'
+            except Exception as error:
+                report['cleanup'][role]=f'UNKNOWN: {error}';report['status']='UNKNOWN'
+        capture.close()
+        if capture.errors:report['status']='UNKNOWN'
+        if not exchange and any(e.get('e') in ('TX','TX_DONE','REQUEST') for e in capture.events):
+            report.update(status='UNKNOWN',failure='unexpected RF activity in non-transmitting bring-up')
+        if exchange and 'exchange' not in report:
+            try:report['exchange']=validate_hello_exchange(capture.events,session)
+            except ValueError as error:report['exchange']=dict(complete=False,validation_error=str(error))
+        report.update(events=capture.events,commands=capture.commands,capture_errors=capture.errors,
+            guard_events=[e for e in capture.events if e.get('e')=='SD_PRESENT_BLOCKED'])
+        proof.note('bringup.json',json.dumps(report,indent=2)+'\n')
+    if report['status']!='PASS':raise ValueError('diagnostic cleanup incomplete: '+str(run_dir))
+    return run_dir
+
