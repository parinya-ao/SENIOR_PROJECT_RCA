+def hello_airtime_budget(config):
+    data=lora_time_on_air_us(12+len(HELLO_PAYLOAD),config)
+    ack=lora_time_on_air_us(12,config)
+    turnaround=config['response_guard_ms']*1000
+    if data>=config['tx_ms']*1000 or ack+turnaround>=config['ack_min_ms']*1000:
+        raise ValueError('HELLO_LORA airtime/turnaround exceeds firmware deadline')
+    return dict(payload_hex=HELLO_PAYLOAD.hex(),max_attempts=1,data_toa_us=data,
+        ack_toa_us=ack,turnaround_guard_us=turnaround,ack_deadline_min_ms=config['ack_min_ms'])
+
+
+def validate_hello_exchange(events,session):
+    rows=[e for e in events if int(e.get('s','0'),16)==session]
+    frames=[]
+    for event in rows:
+        if event.get('e') not in ('TX','RX'):continue
+        frame=wire_frame(event['bytes'])
+        if frame['session']!=session or frame['sequence']!=0:
+            raise ValueError('HELLO_LORA stale session/sequence')
+        data=frame['type']==1
+        if (frame['src'],frame['dst'],frame['payload'],frame['type']) != (
+                (1,2,HELLO_PAYLOAD,1) if data else (2,1,b'',2)):
+            raise ValueError('HELLO_LORA DATA/ACK mismatch')
+        frames.append((event,frame))
+    def frame_rows(role,name,kind):
+        return [e for e,f in frames if e.get('role')==role and e.get('e')==name and f['type']==kind]
+    data=frame_rows('sender','TX',1)
+    if len(data)>1:raise ValueError('more than one physical DATA attempt')
+    def checkpoint(role,name,*,value=None,sequence=0):
+        matches=[e for e in rows if e.get('role')==role and e.get('e')==name]
+        if not matches:return None
+        return len(matches)==1 and matches[0].get('rc')=='0' and matches[0].get('q')==str(sequence) and (
+            value is None or matches[0].get('v')==value)
+    result=dict(gateway_data_tx=True if data else None,
+        gateway_data_tx_done=checkpoint('sender','TX_DONE',value='8'),
+        tracker_data_rx=True if frame_rows('receiver','RX',1) else None,
+        tracker_data_accepted=checkpoint('receiver','ACCEPT',value='1'),
+        tracker_ack_tx=True if frame_rows('receiver','TX',2) else None,
+        tracker_ack_tx_done=checkpoint('receiver','TX_DONE',value='8'),
+        gateway_ack_rx=True if frame_rows('sender','RX',2) else None,
+        gateway_ack_accepted=checkpoint('sender','DELIVERED',value='1'))
+    # Serial streams may interleave; each board's own causal order must hold.
+    chains={'sender':['TX','TX_DONE','RX','DELIVERED'],
+            'receiver':['RX','ACCEPT','TX','TX_DONE']}
+    result['local_order_valid']=all(
+        [e.get('e') for e in rows if e.get('role')==role and e.get('e') in names]==names
+        for role,names in chains.items())
+    result['complete']=all(value is True for value in result.values())
+    return result
+
