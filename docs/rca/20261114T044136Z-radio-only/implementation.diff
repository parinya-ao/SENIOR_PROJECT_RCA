@@ -0,0 +1,23 @@
+#pragma once
+
+#if defined(ARQ_RADIO_ONLY_DIAGNOSTIC) && defined(LORA_ROLE_RECEIVER)
+static bool radio_only_prepare_tracker() {
+    // Startup only: ARQ has no GPS/SD/sensor tasks to stop. Never call this between DATA and ACK.
+    // SAM-M10Q main power is active-low PD5; release USART2/PF0-PF1 before removing it.
+    USART2.CTRLA=0;
+    USART2.CTRLB=0;
+    pinMode(PIN_PF0,INPUT);digitalWrite(PIN_PF0,LOW);
+    pinMode(PIN_PF1,INPUT);digitalWrite(PIN_PF1,LOW);
+    pinMode(PIN_PD4,INPUT);digitalWrite(PIN_PD4,LOW); // GPS TIMEPULSE: no pull-up into unpowered IO.
+    digitalWrite(PIN_PD5,HIGH);pinMode(PIN_PD5,OUTPUT);
+    // GNSS V_BCKP stays connected. IMU/EEPROM remain on main 3V3, with no application traffic.
+    pinMode(PIN_PA5,INPUT);digitalWrite(PIN_PA5,LOW);
+    pinMode(PIN_PA6,INPUT);digitalWrite(PIN_PA6,LOW); // Do not use LED_BUILTIN: it aliases EN-LORA/PA7.
+    // SD shares LoRa SPI without isolation. With power off, a fitted card forbids any SPI drive.
+    pinMode(PIN_PC3,INPUT);digitalWrite(PIN_PC3,LOW);
+    digitalWrite(PIN_PD6,HIGH);pinMode(PIN_PD6,OUTPUT);
+    pinMode(PIN_PA4,INPUT_PULLUP); // CARD1 detect switch closes to ground when a card is fitted.
+    digitalWrite(PIN_PA7,HIGH);pinMode(PIN_PA7,OUTPUT);
+    return digitalRead(PIN_PA4)==HIGH;
+}
+#endif
--- /dev/null
+++ b/tests/test_arq_radio_only.py
@@ -0,0 +1,46 @@
+"""Simulation at firmware setup/loop boundaries; does not establish electrical isolation."""
+from pathlib import Path
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class RadioOnlyTests(unittest.TestCase):
+    def test_radio_only_images_resolve_to_the_existing_role_application_ranges(self):
+        from tools import rf_proof
+
+        config = subprocess.check_output(
+            ['pio', 'project', 'config', '--json-output'], cwd=ROOT, text=True)
+
+        self.assertEqual(rf_proof.application_bounds_for_environment(
+            config, 'sender_arq_radio_only'), (0, 130048))
+        self.assertEqual(rf_proof.application_bounds_for_environment(
+            config, 'receiver_arq_radio_only'), (0, 130048))
+        self.assertTrue(rf_proof.application_layout_verified(
+            ('sender_arq_radio_only', 'receiver_arq_radio_only'), config))
+
+    def test_radio_only_setup_preserves_arq_and_refuses_unpowered_sd_bus_use(self):
+        with tempfile.TemporaryDirectory() as directory:
+            objects = []
+            for source in ('codec', 'sender', 'receiver'):
+                obj = str(Path(directory) / (source + '.o'))
+                objects.append(obj)
+                subprocess.run(['clang', '-std=c11', '-Isrc/arq', '-Iinclude', '-c',
+                                f'src/arq/{source}.c', '-o', obj], cwd=ROOT, check=True)
+            for role in ('SENDER', 'RECEIVER'):
+                binary = str(Path(directory) / role)
+                subprocess.run(['clang', '--driver-mode=g++', '-std=c++11', '-Wall',
+                    '-Wextra', '-Werror', '-Wno-unused-variable', '-Wno-unused-function',
+                    '-Itests/arq/stub', '-Itests/raw_mvp_stub', '-Iinclude', '-Isrc/arq',
+                    '-DLORA_ROLE_' + role, '-DARQ_TEST_MODE', '-DARQ_RADIO_ONLY_DIAGNOSTIC=1',
+                    '-DLORA_BUILD_ID="host-radio-only"', 'tests/arq/adapter_test.cpp',
+                    *objects, '-o', binary], cwd=ROOT, check=True)
+                subprocess.run([binary], check=True)
+                if role == 'RECEIVER':
+                    subprocess.run([binary, 'card'], check=True)
+
+
+if __name__ == '__main__':
+    unittest.main()
