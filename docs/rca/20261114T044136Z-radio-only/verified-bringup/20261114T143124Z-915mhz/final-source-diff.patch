+# Keep the first twenty addresses compatible with archived ARQ snapshots.
+ARQ_REGISTER_ADDRESSES = (
+    1,
+    6,
+    7,
+    8,
+    9,
+    0x4D,
+    0x1D,
+    0x1E,
+    0x26,
+    0x39,
+    0x33,
+    0x3B,
+    0x12,
+    0x13,
+    0x10,
+    0x1B,
+    0x40,
+    0x11,
+    0x18,
+    0x31,
+    0x42,
+    0x20,
+    0x21,
+    0x41,
+)
+HELLO_PAYLOAD = b"HELLO_LORA"
