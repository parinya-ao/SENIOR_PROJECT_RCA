    ${env:receiver.build_flags}
    -DHELLO_RF_DIAGNOSTIC_ONLY=1

[env:sender_mvp]
extends = env:sender
build_src_filter =
    -<*>
    +<mvp/>

[env:receiver_mvp]
extends = env:receiver
build_src_filter =
    -<*>
    +<mvp/>
[env:sender_arq]
extends = env:sender
build_flags =
    ${env.build_flags}
    -fstack-usage
build_src_filter =
    -<*>
    +<arq/>
[env:receiver_arq]
extends = env:receiver
build_flags =
    ${env.build_flags}
    -fstack-usage
build_src_filter =
    -<*>
    +<arq/>
[env:sender_arq_test]
extends = env:sender_arq
build_flags =
    ${env:sender_arq.build_flags}
    -DARQ_TEST_MODE=1
[env:receiver_arq_test]
