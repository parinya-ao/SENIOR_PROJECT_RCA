direction: right

vars: {
  d2-config: {
    theme-id: 4
    layout-engine: tala
    pad: 60
  }
}

classes: {
  decision: { shape: diamond }
  outcome: { shape: document }
}

title: "Focused RCA: cross one boundary at a time" {
  near: top-center
}

echo: "Q+Y: BREAK LOCAL_ECHO failure\nInherited: 200/200 failures\nContinuation: 20/20 failures"
safe: "Power isolation + pinout +\nexternal harness boundary verified?" {
  class: decision
}
blocked: "CURRENT: BLOCKED_PHYSICAL\nUser reported crossover unsafe\n0 crossed cells / 0 causal repeats\nQualified bench access required" {
  class: outcome
}
cross: "Target-only crossover + restore\nN=20 reproduce / N=30 screen\nN=100 only if needed\nRepeat A/B/A before proof" {
  class: decision
}
target: "Follows target\nFreeze external path\nMeasure target UPDI / GND / VDD" {
  class: outcome
}
path: "Follows external path\nSplit cable / port / CP2102 /\nresistor / harness one at a time" {
  class: outcome
}
mixed: "Both pass / both fail / mixed\nCheck intervention / confounds /\ninteraction before attribution" {
  class: outcome
}

echo -> safe: checks prerequisite
safe -> blocked: no / unknown
safe -> cross: yes
cross -> target: repeats with target
cross -> path: repeats with path
cross -> mixed: changes pattern
